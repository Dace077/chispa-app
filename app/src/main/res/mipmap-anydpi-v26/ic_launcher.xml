<?xml version="1.0" encoding="utf-8"?>
<!--
  Icono adaptativo. El fondo sigue siendo vectorial (un degradado violeta), pero
  el primer plano es PNG: lleva el letrero "Speak English" y los vector drawable
  de Android no saben dibujar texto, solo paths.

  Los PNG los genera `herramientas/generar-iconos.py`. No editarlos a mano: son
  22 archivos que tienen que ir coordinados entre densidades.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
