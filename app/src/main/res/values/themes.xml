<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Tema "puente" que usa el sistema antes de que Compose tome el control.
      Evita el flash blanco al abrir la app.
    -->
    <style name="Theme.Chispa.Starting" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_indigo_900</item>
        <item name="android:statusBarColor">@color/brand_indigo_900</item>
        <item name="android:navigationBarColor">@color/brand_indigo_900</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Tema mínimo para el widget: RemoteViews no hereda el tema de la app. -->
    <style name="Theme.Chispa.Widget" parent="@android:style/Theme.DeviceDefault">
        <item name="android:colorBackground">@color/brand_indigo_900</item>
    </style>
</resources>
