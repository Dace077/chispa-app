            { "en": "probably", "es": "probablemente" },
            { "en": "as soon as", "es": "en cuanto" },
            { "en": "otherwise", "es": "si no, de lo contrario" }
          ],
          "exercises": [
            {
              "type": "tip",
              "title": "Tras 'if' NUNCA va 'will'",
              "body": "El primer condicional habla de algo probable en el futuro: 'If it rains, I will stay home'. Fíjate en el detalle que casi todo el mundo falla: la parte del 'if' va en PRESENTE, aunque hable del futuro. 'If it will rain' está mal. Lo mismo con when, as soon as y until: 'I'll call you when I arrive'.",
              "examples": [
                { "en": "If you study, you will pass.", "es": "Si estudias, aprobarás." },
                { "en": "I'll call you as soon as I get there.", "es": "Te llamo en cuanto llegue." },
                { "en": "Unless you hurry, we'll be late.", "es": "Como no te des prisa, llegaremos tarde." }
              ]
            },
            {
              "type": "fill_in_blank",
              "sentence": "If it ___ tomorrow, we will cancel.",
              "answer": "rains",
              "options": ["rains", "will rain", "rained", "is raining"],
              "translation": "Si llueve mañana, cancelamos."
            },
            {
              "type": "fill_in_blank",
              "sentence": "I'll text you when I ___ home.",
              "answer": "get",
              "options": ["get", "will get", "got", "getting"],
              "translation": "Te escribo cuando llegue a casa."
            },
