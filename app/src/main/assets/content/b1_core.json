          ],
          "exercises": [
            {
              "type": "tip",
              "title": "Por qué los phrasal verbs dan tanta guerra",
              "body": "Un phrasal verb es un verbo más una preposición que juntos significan algo que no adivinarías: 'give' es dar y 'up' es arriba, pero 'give up' es rendirse. No intentes traducir las piezas por separado: apréndelos como si fueran palabras nuevas. Algunos son separables ('turn the TV off') y otros no ('look after the kids', nunca 'look the kids after').",
              "examples": [
                { "en": "Don't give up!", "es": "¡No te rindas!" },
                { "en": "I need to find out the truth.", "es": "Necesito averiguar la verdad." },
                { "en": "Turn off the lights, please.", "es": "Apaga las luces, por favor." }
              ]
            },
            {
              "type": "matching_pairs",
              "prompt": "Une los phrasal verbs",
              "pairs": [
                ["give up", "rendirse"],
                ["find out", "averiguar"],
                ["look after", "cuidar de"],
                ["put off", "posponer"]
              ]
            },
            {
              "type": "multiple_choice",
              "direction": "en_es",
              "prompt": "We ran out of milk",
              "options": [
                "Nos quedamos sin leche",
                "Corrimos por la leche",
                "Se nos cayó la leche",
                "Compramos leche"
