              "audioText": "It was one of the best days of my life",
              "answer": "It was one of the best days of my life",
              "translation": "Fue uno de los mejores días de mi vida"
            },
            {
              "type": "matching_pairs",
              "prompt": "Une los conectores",
              "pairs": [
                ["at first", "al principio"],
                ["then", "entonces"],
                ["after that", "después de eso"],
