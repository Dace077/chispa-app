          "exercises": [
            {
              "type": "tip",
              "title": "Pasado continuo: el fondo de la escena",
              "body": "Para contar historias el inglés combina dos pasados. El continuo ('was/were + -ing') pinta el decorado: lo que estaba ocurriendo. El simple mete la acción que interrumpe: 'I was walking home when it started to rain'. Truco: la acción larga va con 'while', la corta con 'when'.",
              "examples": [
                { "en": "I was cooking when he called.", "es": "Estaba cocinando cuando llamó." },
                { "en": "While she was sleeping, the phone rang.", "es": "Mientras dormía, sonó el teléfono." },
                { "en": "They were waiting for hours.", "es": "Estuvieron esperando horas." }
              ]
            },
            {
              "type": "fill_in_blank",
              "sentence": "I ___ walking home when I saw her.",
              "answer": "was",
              "options": ["was", "were", "am", "have"],
              "translation": "Iba caminando a casa cuando la vi."
            },
            {
              "type": "fill_in_blank",
              "sentence": "___ we were eating, the lights went out.",
              "answer": "While",
              "options": ["While", "When", "Then", "After"],
              "translation": "Mientras comíamos, se fue la luz."
            },
