            { "en": "gone", "es": "ido (participio de go)" },
            { "en": "seen", "es": "visto" },
            { "en": "done", "es": "hecho" }
          ],
          "exercises": [
            {
              "type": "tip",
              "title": "Presente perfecto vs pasado simple",
              "body": "La diferencia no es el tiempo transcurrido, es si te importa CUÁNDO pasó. Si mencionas o piensas en un momento concreto y cerrado, usa pasado simple: 'I saw that film last night'. Si hablas de una experiencia sin fecha, o de algo que sigue teniendo efecto ahora, usa presente perfecto: 'I have seen that film'. Regla práctica: si en la frase aparece yesterday, last week o ago, va pasado simple, sin excepción.",
              "examples": [
                { "en": "I have visited Japan.", "es": "He visitado Japón (alguna vez)." },
                { "en": "I visited Japan in 2019.", "es": "Visité Japón en 2019." },
                { "en": "She has lived here since 2020.", "es": "Vive aquí desde 2020." }
              ]
            },
            {
              "type": "fill_in_blank",
              "sentence": "I have lived here ___ five years.",
              "answer": "for",
              "options": ["for", "since", "from", "during"],
              "translation": "Vivo aquí desde hace cinco años."
            },
            {
              "type": "fill_in_blank",
              "sentence": "She has worked here ___ 2020.",
              "answer": "since",
              "options": ["since", "for", "from", "ago"],
              "translation": "Ella trabaja aquí desde 2020."
            },
            {
              "type": "multiple_choice",
              "direction": "es_en",
              "prompt": "¿Cuál es correcta?",
              "options": [
                "I saw him yesterday",
                "I have seen him yesterday",
                "I have saw him yesterday",
                "I did seen him yesterday"
              ],
              "answer": "I saw him yesterday",
              "hint": "Con 'yesterday' siempre pasado simple"
            },
            {
              "type": "translate",
              "direction": "es_en",
              "prompt": "¿Alguna vez has estado en Londres?",
              "answer": "Have you ever been to London?",
              "alternatives": ["Have you ever been to London"]
            },
            {
