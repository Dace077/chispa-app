          "exercises": [
            {
              "type": "tip",
              "title": "Falsos amigos que arruinan una opinión",
              "body": "'Actually' significa 'en realidad', no 'actualmente' (eso es 'currently'). 'Eventually' es 'finalmente', no 'eventualmente'. 'Sensible' es 'sensato', no 'sensible' (eso es 'sensitive'). Y 'realize' es 'darse cuenta', no 'realizar'. Estos cuatro son los que más malentendidos causan en una conversación seria.",
              "examples": [
                { "en": "Actually, I disagree.", "es": "En realidad, no estoy de acuerdo." },
                { "en": "Currently, I work from home.", "es": "Actualmente trabajo desde casa." },
                { "en": "That's a sensible decision.", "es": "Es una decisión sensata." }
              ]
            },
            {
              "type": "matching_pairs",
              "prompt": "Une los conectores de opinión",
              "pairs": [
                ["however", "sin embargo"],
                ["although", "aunque"],
                ["therefore", "por lo tanto"],
                ["besides", "además"]
              ]
            },
            {
              "type": "multiple_choice",
              "direction": "en_es",
              "prompt": "Actually, I don't think so.",
