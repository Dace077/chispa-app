              "answer": "I haven't finished yet"
            },
            {
              "type": "listen_and_type",
              "audioText": "I have just arrived home",
              "answer": "I have just arrived home",
              "translation": "Acabo de llegar a casa"
            },
            {
              "type": "matching_pairs",
