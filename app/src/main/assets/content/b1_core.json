          ],
          "exercises": [
            {
              "type": "tip",
              "title": "Cuando el 'quién' no importa",
              "body": "La pasiva se forma con 'to be' + participio: 'The house was built in 1920'. Se usa cuando lo interesante es la acción, no quién la hizo. Es muy común en noticias, textos científicos y avisos: 'Smoking is not allowed'. El español prefiere el 'se': 'se prohíbe fumar'. Si quieres decir quién lo hizo, se añade con 'by'.",
              "examples": [
                { "en": "English is spoken here.", "es": "Aquí se habla inglés." },
                { "en": "The book was written by Orwell.", "es": "El libro fue escrito por Orwell." },
                { "en": "These shoes are made in Italy.", "es": "Estos zapatos se hacen en Italia." }
              ]
            },
