        { "en": "My luggage didn't arrive.", "es": "Mi equipaje no llegó." },
        { "en": "Where can I get a taxi?", "es": "¿Dónde puedo tomar un taxi?" },
        { "en": "Do I need to check in again?", "es": "¿Tengo que documentar otra vez?" },
        { "en": "How long is the layover?", "es": "¿De cuánto es la escala?" },
        { "en": "Excuse me, that's my seat.", "es": "Disculpe, ese es mi asiento." }
      ]
    },
