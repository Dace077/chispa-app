          "vocab": [
            { "en": "a table for two", "es": "una mesa para dos" },
            { "en": "the menu", "es": "la carta" },
            { "en": "I'd like to order", "es": "quisiera pedir" },
            { "en": "starter", "es": "entrante" },
            { "en": "main course", "es": "plato principal" },
            { "en": "dessert", "es": "postre" },
            { "en": "the bill", "es": "la cuenta", "note": "En EE. UU. se dice 'the check'" },
            { "en": "I'm allergic to", "es": "soy alérgico a" },
            { "en": "rare / medium / well done", "es": "poco hecho / al punto / muy hecho" },
            { "en": "still or sparkling?", "es": "¿sin gas o con gas?" },
            { "en": "to go", "es": "para llevar" },
            { "en": "that was delicious", "es": "estaba delicioso" }
          ],
          "exercises": [
            {
              "type": "tip",
              "title": "'Menu' no es menú del día",
              "body": "En inglés 'the menu' es la carta completa, no el menú del día (eso es 'the set menu' o 'the daily special'). Otro falso amigo peligroso: 'entrée' en Estados Unidos es el plato principal, no el entrante. Y para pedir la cuenta, en Reino Unido se dice 'the bill' y en Estados Unidos 'the check'.",
              "examples": [
                { "en": "Could I see the menu, please?", "es": "¿Me trae la carta, por favor?" },
                { "en": "What's the daily special?", "es": "¿Cuál es el menú del día?" },
                { "en": "Could we have the bill, please?", "es": "¿Nos trae la cuenta, por favor?" }
              ]
            },
            {
              "type": "matching_pairs",
              "prompt": "Une el vocabulario de restaurante",
              "pairs": [
                ["starter", "entrante"],
                ["main course", "plato principal"],
                ["dessert", "postre"],
                ["the bill", "la cuenta"]
              ]
            },
            {
              "type": "multiple_choice",
              "direction": "en_es",
              "prompt": "How would you like your steak?",
              "options": [
                "¿Cómo quiere el filete de hecho?",
                "¿Le gusta el filete?",
                "¿Quiere filete?",
                "¿De qué es el filete?"
              ],
              "answer": "¿Cómo quiere el filete de hecho?"
            },
            {
              "type": "multiple_choice",
              "direction": "en_es",
              "prompt": "Still or sparkling?",
              "options": [
                "¿Agua sin gas o con gas?",
                "¿Todavía o brillante?",
                "¿Sigue igual o cambió?",
                "¿Frío o del tiempo?"
              ],
              "answer": "¿Agua sin gas o con gas?"
            },
            {
              "type": "fill_in_blank",
              "sentence": "I'm ___ to nuts, please check the ingredients.",
              "answer": "allergic",
              "options": ["allergic", "allergy", "alergic", "allergical"],
              "translation": "Soy alérgico a los frutos secos, revise los ingredientes por favor."
            },
            {
              "type": "fill_in_blank",
              "sentence": "Could we have a table ___ two, please?",
              "answer": "for",
              "options": ["for", "of", "to", "by"],
              "translation": "¿Nos da una mesa para dos, por favor?"
            },
            {
              "type": "translate",
              "direction": "es_en",
              "prompt": "¿Nos trae la cuenta, por favor?",
              "answer": "Could we have the bill, please?",
              "alternatives": ["Can we have the bill please", "Could we have the check please"]
            },
            {
              "type": "word_order",
              "prompt": "Quisiera pedir el plato principal ahora",
              "words": ["I'd", "like", "to", "order", "the", "main", "course", "now"],
              "answer": "I'd like to order the main course now"
            },
            {
              "type": "listen_and_type",
              "audioText": "Is this dish vegetarian?",
              "answer": "Is this dish vegetarian?",
              "translation": "¿Este plato es vegetariano?"
            },
            {
              "type": "speak_and_repeat",
              "prompt": "That was delicious, thank you very much.",
              "translation": "Estaba delicioso, muchas gracias."
            }
          ]
        },
        {
          "id": "travel_l4",
          "title": "Emergencias",
          "vocab": [
            { "en": "help!", "es": "¡ayuda!" },
            { "en": "call an ambulance", "es": "llame a una ambulancia" },
            { "en": "I need a doctor", "es": "necesito un médico" },
            { "en": "I've lost my passport", "es": "he perdido mi pasaporte" },
            { "en": "I've been robbed", "es": "me han robado" },
            { "en": "police station", "es": "comisaría" },
            { "en": "embassy", "es": "embajada" },
            { "en": "I don't feel well", "es": "no me encuentro bien" },
            { "en": "it's an emergency", "es": "es una emergencia" },
            { "en": "can you help me?", "es": "¿puede ayudarme?" },
            { "en": "I don't speak English well", "es": "no hablo bien inglés" },
            { "en": "could you repeat that?", "es": "¿puede repetirlo?" }
          ],
          "exercises": [
            {
              "type": "tip",
              "title": "Las frases que hay que saber de memoria",
              "body": "En una emergencia no vas a construir frases complejas. Memoriza estas tal cual: 'It's an emergency', 'I need a doctor', 'Call the police', 'I've lost my passport'. Y una que salva conversaciones: 'Sorry, could you speak more slowly?'. El número de emergencias es 911 en EE. UU. y Canadá, 999 en Reino Unido y 112 en toda la Unión Europea.",
              "examples": [
                { "en": "It's an emergency, please help.", "es": "Es una emergencia, por favor ayude." },
                { "en": "Could you speak more slowly?", "es": "¿Podría hablar más despacio?" },
                { "en": "Where is the nearest hospital?", "es": "¿Dónde está el hospital más cercano?" }
              ]
            },
            {
              "type": "matching_pairs",
              "prompt": "Une las frases de emergencia",
              "pairs": [
                ["call an ambulance", "llame a una ambulancia"],
                ["I've been robbed", "me han robado"],
                ["police station", "comisaría"],
                ["embassy", "embajada"]
              ]
            },
            {
              "type": "multiple_choice",
              "direction": "en_es",
              "prompt": "Where is the nearest hospital?",
              "options": [
                "¿Dónde está el hospital más cercano?",
                "¿Cómo se llama el hospital?",
                "¿El hospital está lejos?",
                "¿Hay hospital aquí?"
              ],
              "answer": "¿Dónde está el hospital más cercano?"
            },
            {
              "type": "fill_in_blank",
              "sentence": "I've ___ my passport.",
              "answer": "lost",
              "options": ["lost", "lose", "losed", "loosed"],
              "translation": "He perdido mi pasaporte."
            },
            {
              "type": "fill_in_blank",
              "sentence": "Could you speak more ___, please?",
              "answer": "slowly",
              "options": ["slowly", "slow", "slower", "slowest"],
              "translation": "¿Podría hablar más despacio, por favor?"
            },
            {
              "type": "translate",
              "direction": "es_en",
              "prompt": "Necesito un médico, es una emergencia",
              "answer": "I need a doctor, it's an emergency"
            },
            {
              "type": "word_order",
              "prompt": "¿Puede ayudarme, por favor?",
              "words": ["Can", "you", "help", "me,", "please?"],
              "answer": "Can you help me, please?"
            },
            {
              "type": "listen_and_type",
              "audioText": "I don't speak English very well",
              "answer": "I don't speak English very well",
              "translation": "No hablo inglés muy bien"
            },
            {
              "type": "speak_and_repeat",
              "prompt": "Please call the police, it's an emergency.",
              "translation": "Por favor llame a la policía, es una emergencia."
            },
            {
              "type": "culture_note",
              "title": "Los números que salvan",
              "body": "Emergencias: 911 en Estados Unidos y Canadá, 999 en el Reino Unido (aunque el 112 también funciona), 000 en Australia y 111 en Nueva Zelanda. El 112 funciona en toda la Unión Europea y en muchos países más desde cualquier móvil, incluso sin cobertura de tu operador y sin tarjeta SIM. Apúntatelo antes de viajar."
            }
          ]
        }
