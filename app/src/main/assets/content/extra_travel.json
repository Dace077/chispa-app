        {
          "id": "travel_l1",
          "title": "En el aeropuerto",
          "vocab": [
            { "en": "check-in desk", "es": "mostrador de facturación" },
            { "en": "boarding pass", "es": "tarjeta de embarque" },
            { "en": "carry-on", "es": "equipaje de mano" },
            { "en": "checked bag", "es": "maleta facturada" },
            { "en": "security check", "es": "control de seguridad" },
            { "en": "departure", "es": "salida" },
            { "en": "arrival", "es": "llegada" },
            { "en": "connecting flight", "es": "vuelo de conexión" },
            { "en": "baggage claim", "es": "recogida de equipajes" },
            { "en": "aisle seat", "es": "asiento de pasillo", "ipa": "/aɪl/", "note": "La 's' es muda" },
            { "en": "window seat", "es": "asiento de ventanilla" },
            { "en": "layover", "es": "escala" }
          ],
          "exercises": [
            {
              "type": "tip",
              "title": "Las tres preguntas que te harán siempre",
              "body": "En cualquier aeropuerto anglosajón te preguntarán casi lo mismo: '¿Window or aisle?' (¿ventanilla o pasillo?), 'Any bags to check?' (¿maletas para facturar?) y 'What's the purpose of your visit?' en inmigración. Respuestas seguras: 'Aisle, please', 'Just this carry-on' y 'Tourism' o 'Business'. Con eso pasas el 90% de los trámites.",
              "examples": [
                { "en": "Window or aisle?", "es": "¿Ventanilla o pasillo?" },
                { "en": "Just one carry-on, thanks.", "es": "Solo equipaje de mano, gracias." },
                { "en": "I'm here on holiday.", "es": "Estoy aquí de vacaciones." }
              ]
            },
            {
              "type": "matching_pairs",
              "prompt": "Une el vocabulario de aeropuerto",
              "pairs": [
                ["boarding pass", "tarjeta de embarque"],
                ["carry-on", "equipaje de mano"],
                ["baggage claim", "recogida de equipajes"],
                ["layover", "escala"]
              ]
            },
            {
              "type": "multiple_choice",
              "direction": "en_es",
              "prompt": "Window or aisle?",
              "options": [
                "¿Ventanilla o pasillo?",
                "¿Ventana abierta o cerrada?",
                "¿Vas o vuelves?",
                "¿Con o sin equipaje?"
              ],
              "answer": "¿Ventanilla o pasillo?"
            },
            {
              "type": "multiple_choice",
              "direction": "en_es",
              "prompt": "What's the purpose of your visit?",
              "options": [
                "¿Cuál es el motivo de su viaje?",
                "¿A quién visita?",
                "¿Cuánto tiempo se queda?",
                "¿Dónde se aloja?"
              ],
              "answer": "¿Cuál es el motivo de su viaje?"
            },
            {
              "type": "fill_in_blank",
              "sentence": "I'd like an ___ seat, please.",
              "answer": "aisle",
              "options": ["aisle", "window", "middle", "front"],
              "translation": "Quisiera un asiento de pasillo, por favor."
            },
            {
              "type": "fill_in_blank",
              "sentence": "My ___ flight leaves in two hours.",
              "answer": "connecting",
              "options": ["connecting", "connected", "connection", "connect"],
              "translation": "Mi vuelo de conexión sale en dos horas."
            },
            {
              "type": "translate",
              "direction": "es_en",
              "prompt": "¿Dónde está la puerta de embarque doce?",
              "answer": "Where is gate twelve?",
              "alternatives": ["Where is gate 12?"]
            },
            {
              "type": "word_order",
              "prompt": "He perdido mi vuelo de conexión",
              "words": ["I", "missed", "my", "connecting", "flight"],
              "answer": "I missed my connecting flight"
            },
            {
              "type": "listen_and_type",
              "audioText": "Do you have any bags to check?",
              "answer": "Do you have any bags to check?",
              "translation": "¿Tiene maletas para facturar?"
            },
            {
              "type": "speak_and_repeat",
              "prompt": "Excuse me, where is the baggage claim?",
              "translation": "Disculpe, ¿dónde está la recogida de equipajes?"
            }
          ]
        },
        {
          "id": "travel_l2",
          "title": "En el hotel",
          "vocab": [
            { "en": "I have a reservation", "es": "tengo una reserva" },
            { "en": "single room", "es": "habitación individual" },
            { "en": "double room", "es": "habitación doble" },
            { "en": "check-out time", "es": "hora de salida" },
            { "en": "is breakfast included?", "es": "¿el desayuno está incluido?" },
            { "en": "the key card", "es": "la tarjeta llave" },
            { "en": "the air conditioning", "es": "el aire acondicionado" },
            { "en": "it doesn't work", "es": "no funciona" },
            { "en": "extra towels", "es": "toallas extra" },
            { "en": "wake-up call", "es": "llamada para despertar" },
            { "en": "luggage storage", "es": "consigna de equipaje" },
            { "en": "could you recommend", "es": "¿podría recomendarme?" }
          ],
          "exercises": [
            {
              "type": "tip",
              "title": "Quejarse en un hotel sin discutir",
              "body": "Para reportar un problema, la fórmula amable es: 'Excuse me, there seems to be a problem with…'. Usar 'seems' suaviza mucho. Y para pedir algo: 'Would it be possible to…?'. Evita 'I want', que suena exigente. Si algo no funciona: 'The shower isn't working' es neutro y suficiente.",
              "examples": [
                { "en": "There seems to be a problem with the heating.", "es": "Parece que hay un problema con la calefacción." },
                { "en": "Would it be possible to get extra towels?", "es": "¿Sería posible tener toallas extra?" },
                { "en": "The wifi isn't working in my room.", "es": "El wifi no funciona en mi habitación." }
              ]
            },
            {
              "type": "matching_pairs",
              "prompt": "Une el vocabulario de hotel",
              "pairs": [
                ["single room", "habitación individual"],
                ["check-out time", "hora de salida"],
                ["key card", "tarjeta llave"],
                ["wake-up call", "llamada para despertar"]
              ]
            },
            {
              "type": "multiple_choice",
              "direction": "en_es",
              "prompt": "Is breakfast included?",
              "options": [
                "¿El desayuno está incluido?",
                "¿A qué hora es el desayuno?",
                "¿Dónde se desayuna?",
                "¿Quiere desayunar?"
              ],
              "answer": "¿El desayuno está incluido?"
            },
            {
              "type": "fill_in_blank",
              "sentence": "I have a ___ under the name García.",
              "answer": "reservation",
              "options": ["reservation", "reserve", "reserved", "booking room"],
              "translation": "Tengo una reserva a nombre de García."
            },
            {
              "type": "fill_in_blank",
              "sentence": "The air conditioning doesn't ___.",
              "answer": "work",
              "options": ["work", "works", "working", "worked"],
              "translation": "El aire acondicionado no funciona."
            },
            {
              "type": "translate",
              "direction": "es_en",
              "prompt": "¿A qué hora es la salida?",
              "answer": "What time is check-out?",
              "alternatives": ["What time is check out?"]
            },
            {
              "type": "word_order",
              "prompt": "¿Podría recomendarme un buen restaurante?",
              "words": ["Could", "you", "recommend", "a", "good", "restaurant?"],
              "answer": "Could you recommend a good restaurant?"
            },
            {
              "type": "listen_and_type",
              "audioText": "Can I leave my luggage here until five?",
              "answer": "Can I leave my luggage here until five?",
              "translation": "¿Puedo dejar mi equipaje aquí hasta las cinco?"
            },
            {
              "type": "speak_and_repeat",
              "prompt": "Excuse me, there seems to be a problem with my room.",
              "translation": "Disculpe, parece que hay un problema con mi habitación."
            },
            {
              "type": "translate",
              "direction": "en_es",
              "prompt": "Would it be possible to get a late check-out?",
              "answer": "¿Sería posible salir más tarde?"
            }
          ]
        },
        {
